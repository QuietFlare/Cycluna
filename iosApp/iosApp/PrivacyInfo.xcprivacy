<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Cycluna does not track users (no cross-app/website tracking, no ad SDKs). -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <!--
      Collected data types: EMPTY for now (local sample data only, no backend).
      When the Cloudflare backend + accounts land, declare the health data & account
      identifiers collected here, and mirror them in App Store Connect's App Privacy.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <!--
      Required-reason APIs. Add an entry here whenever a new one is used
      (file/disk timestamps, active keyboards, system boot time, …) — App Store
      submission scanning rejects the build otherwise (ITMS-91053).
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- @AppStorage (RootView, MeView, OnboardingView) = UserDefaults.
                 CA92.1: accessed only to read/write this app's own settings. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
