<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Cycluna does not track users (no cross-app/website tracking, no ad SDKs). -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <!--
      Collected data types: EMPTY for now (local sample data only, no backend).
      When the Cloudflare backend + accounts land, declare the health data & account
      identifiers collected here, and mirror them in App Store Connect's App Privacy.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <!-- Required-reason APIs: none used yet. Add entries when using UserDefaults,
         file/disk timestamps, etc. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array/>
</dict>
</plist>
