<?xml version="1.0" encoding="utf-8"?>
<!--
  The Cycluna crescent, ported from tools/RenderIcon.swift's 100×100 design space into the
  108dp adaptive canvas. Every coordinate is the iOS one scaled by 0.72 about the centre, so
  the mark occupies the same share of the *visible* 72dp area that it does of the iOS square
  and the two icons read as the same shape.
      outer disc  iOS (47,50) r31  →  (51.84, 54) r22.32
      cut disc    iOS (69,33) r25  →  (67.68, 41.76) r18

  The clip-path is load-bearing. An even-odd fill ALONE gives the XOR of the two discs, and
  the cut disc overhangs the outer one, so that overhang would be filled as well. Clipping to
  the outer disc first intersects it away, leaving outer-minus-inner: a real crescent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group>
        <clip-path android:pathData="M29.52,54a22.32,22.32 0 1,0 44.64,0a22.32,22.32 0 1,0 -44.64,0z" />
        <path
            android:fillType="evenOdd"
            android:pathData="M29.52,54a22.32,22.32 0 1,0 44.64,0a22.32,22.32 0 1,0 -44.64,0z M49.68,41.76a18,18 0 1,0 36,0a18,18 0 1,0 -36,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="28.08"
                    android:startY="29.52"
                    android:endX="77.04"
                    android:endY="84.24">
                    <item android:offset="0" android:color="#8C6BC4" />
                    <item android:offset="0.45" android:color="#6B3FA0" />
                    <item android:offset="1" android:color="#D4849A" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
