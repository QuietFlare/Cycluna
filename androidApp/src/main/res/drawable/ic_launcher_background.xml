<?xml version="1.0" encoding="utf-8"?>
<!--
  The cream field behind the crescent, matching the iOS icon's "day" variant
  (tools/RenderIcon.swift): a radial wash from FFFBF6 near the centre out to F2E7DC.

  Full-bleed across the whole 108dp adaptive canvas — the launcher masks it to whatever
  shape the device uses, so anything short of the edges would show a gap.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48.24"
                android:gradientRadius="56.16"
                android:startColor="#FFFBF6"
                android:endColor="#F2E7DC" />
        </aapt:attr>
    </path>
</vector>
