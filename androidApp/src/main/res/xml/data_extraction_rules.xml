<?xml version="1.0" encoding="utf-8"?>
<!--
  Cycle data is reproductive-health data and never leaves the device. Cloud backup and
  device-to-device transfer are both refused outright rather than filtered, so a new phone
  starts empty instead of silently restoring someone's cycle history from Google's servers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
